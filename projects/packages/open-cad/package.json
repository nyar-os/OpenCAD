{
    "name": "@wae/open-cad",
    "version": "0.0.0",
    "private": true,
    "description": "Drawings, layers, constraints and exchange formats on one native model",
    "license": "Apache-2.0",
    "type": "module",
    "engines": {
        "node": ">=18"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "open-cad": "./dist/cli.js"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "locales"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "test": "tsc -p tsconfig.json && node --test dist/smoke.test.js"
    },
    "keywords": [
        "cad",
        "drawing",
        "dwg",
        "dxf",
        "wae"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/nyar-os/OpenCAD.git",
        "directory": "projects/packages/open-cad"
    },
    "devDependencies": {
        "@types/node": "^22.20.4",
        "typescript": "^5.9.2"
    },
    "dependencies": {
        "@wae/commander": "0.0.7"
    },
    "optionalDependencies": {
        "@wae/open-cad-darwin-arm64": "workspace:*",
        "@wae/open-cad-darwin-x64": "workspace:*",
        "@wae/open-cad-linux-arm64": "workspace:*",
        "@wae/open-cad-linux-x64": "workspace:*",
        "@wae/open-cad-win32-x64": "workspace:*"
    }
}
