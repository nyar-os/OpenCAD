</style>

<script client>
const FORMATS = ["dwg", "dxf", "step", "stp", "iges", "igs", "stl", "obj", "svg", "pdf", "png", "jpg"];

export default class IndexPage {
    static meta() {
        return {
            title: "OpenCAD — structured drawings for people and agents",
            description:
                "OpenCAD keeps one drawing model with working create, edit, undo/redo, layers, inspection, ASCII DXF import and SVG/DXF/PDF export, while the interactive viewport and STEP/STL stay clearly marked as unfinished.",
        };
    }

    formatRows() {
        const declared = {
            dxf: { importState: "partial", editState: "partial", exportState: "supported" },
            svg: { importState: "unsupported", editState: "unsupported", exportState: "supported" },
            pdf: { importState: "unsupported", editState: "unsupported", exportState: "supported" },
        };
        return FORMATS.map((name) => {
            const row = declared[name] || { importState: "unsupported", editState: "unsupported", exportState: "unsupported" };
            const status =
                row.importState !== "unsupported"
                    ? row.importState === "partial"
                        ? "partial"
                        : "import + export"
                    : row.exportState === "supported"
                      ? "export only"
                      : "unsupported";
            return Object.assign({ name, status }, row);
        });
    }

    statusClass(row) {
        return row.status === "unsupported" ? "chip chip--blocked" : "chip chip--available";
    }
}
</script>
